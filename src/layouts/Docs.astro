---
import'@fontsource-variable/inter';import'../styles/official.css';
import Icon from'../components/Icon.astro';import Search from'../components/Search.astro';import NavItems from'../components/NavItems.astro';
import{groups,pages,local,base}from'../lib/navigation';import manifest from'../../upstream/manifest.json';
interface Props{title:string;path:string;description?:string;headings:{depth:number;slug:string;text:string}[]}
const{title,path,description='',headings=[]}=Astro.props;const page=pages.find(p=>p.path===path);const index=pages.findIndex(p=>p.path===path);const prev=pages[index-1],next=pages[index+1];const original=path==='docs/latest'?'https://pi.dev/docs/latest':`https://pi.dev/${path}`;
---
<!doctype html><html lang="zh-CN" data-theme="light"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title} - Pi 中文文档</title><meta name="description" content={description}/><link rel="canonical" href={`https://docs.starlandai.com${local(path)}/`}/><link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml"/><meta property="og:title" content={title}/><meta property="og:locale" content="zh_CN"/><script is:inline>try{const t=localStorage.getItem('pi-docs-theme');document.documentElement.dataset.theme=t==='dark'||(!t&&matchMedia('(prefers-color-scheme:dark)').matches)?'dark':'light'}catch{}</script></head><body>
<a class="skip-link" href="#content-area">跳到正文</a>
<header id="navbar"><div class="topbar"><button class="icon-button mobile-menu" aria-label="打开导航" aria-expanded="false"><Icon name="menu"/></button><a class="brand" href={local('')} aria-label="Pi 中文文档首页"><img class="light-logo" src={`${base}/logo/light.svg`} alt="Pi"/><img class="dark-logo" src={`${base}/logo/dark.svg`} alt="Pi"/></a><details class="version-picker"><summary>Latest · 中文译本<Icon name="down" size={14}/></summary><div><strong>非官方简体中文文档</strong><span>源码快照：2026-10-28</span><a href="https://pi.dev/docs/latest/">查看官方英文版 ↗</a></div></details><button class="search-trigger" data-open-search aria-label="搜索文档"><Icon name="search" size={16}/><span>搜索...</span><kbd>⌘ K</kbd></button><a class="assistant-link" href={original} target="_blank" rel="noreferrer">英文原文<Icon name="external" size={12}/></a><nav class="top-links" aria-label="外部链接"><a href="https://pi.dev/">Pi 官网</a><a href="https://github.com/CBx-2023/pi-zh-docs">GitHub</a><a href="https://pi.dev/packages">Packages</a></nav><button class="icon-button theme-toggle" aria-label="切换明暗主题"><Icon name="monitor"/></button></div><nav class="section-tabs" aria-label="主要导航"><a class="active" href={local('')}>文档</a><a href="https://pi.dev/changelog">更新日志</a><a href="https://pi.dev/models">模型</a><a href="https://pi.dev/packages">扩展包</a><a href="/mcp-zh-docs/">MCP 中文文档</a><a href={local('translation-guide')}>翻译说明</a></nav></header>
<div class="mobile-backdrop"></div><div class="docs-shell"><aside id="sidebar" aria-label="文档导航">{groups.map(g=><section><h3>{g.label}</h3><NavItems items={g.items} current={path}/></section>)}<div class="sidebar-about"><a href={local('translation-guide')}>翻译约定与来源</a><span>42 篇中文文档 · 保留代码与原文链接</span></div></aside>
<main class="doc-main" id="content-area" data-pagefind-body><div class="page-group">{page?.group||'文档'}</div><div class="page-heading"><h1 id="page-title" data-pagefind-meta="title">{title}</h1><button class="copy-page" aria-label="复制页面" data-copy-url={page?`${local(path)}.md`:undefined}><Icon name="copy" size={16}/><span>复制页面</span></button></div><div class="mdx-content" id="content"><slot/></div><div class="translation-attribution" data-pagefind-ignore><span>非官方简体中文译本</span><a href={original}>英文原文 ↗</a><a href={`https://github.com/earendil-works/pi/tree/${manifest.commit}`}>源码 {manifest.commit.slice(0,7)}</a></div><nav class="pagination" aria-label="翻页" data-pagefind-ignore>{prev?<a href={local(prev.path)}><span>← 上一篇</span><strong>{prev.label}</strong></a>:<span/>}{next&&<a class="next" href={local(next.path)}><span>下一篇 →</span><strong>{next.label}</strong></a>}</nav><footer data-pagefind-ignore><div><a href="https://github.com/CBx-2023/pi-zh-docs">GitHub</a><a href="https://pi.dev/">Pi 官网</a></div><p>原文 © 2025 Mario Zechner、Earendil Inc. 及贡献者。<br/>非官方简体中文译本 · <a href={local('translation-guide')}>翻译说明</a> · <a href={`${base}/upstream-license.txt`}>MIT 许可</a></p></footer></main>
<aside class="page-toc" aria-label="本页内容"><div class="toc-label"><Icon name="toc" size={14}/>本页内容</div><ul>{headings.filter(h=>h.depth>=2&&h.depth<=3).map(h=><li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></aside></div><Search/><script src="../scripts/docs.ts"/></body></html>
