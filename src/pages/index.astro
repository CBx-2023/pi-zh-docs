---
import{getEntry,render}from'astro:content';import Docs from'../layouts/Docs.astro';const entry=await getEntry('docs','docs/latest');if(!entry)throw new Error('Missing Pi overview');const{Content,headings}=await render(entry);
---
<Docs title={entry.data.title} path={entry.id} headings={headings}><Content/></Docs>
