---
import{getCollection,render}from'astro:content';import Docs from'../layouts/Docs.astro';
export async function getStaticPaths(){return(await getCollection('docs')).map(entry=>({params:{slug:entry.id},props:{entry}}))}
const{entry}=Astro.props;const{Content,headings}=await render(entry);
---
<Docs title={entry.data.title} path={entry.id} headings={headings}><Content/></Docs>
